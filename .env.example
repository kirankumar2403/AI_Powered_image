# PostgreSQL (SQLAlchemy + psycopg3)

# Service ports
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Trained model
MODEL_PATH=models/quality_pipeline.joblib
MODEL_VERSION=1.0.0

# Uploads
MAX_UPLOAD_BYTES=8388608
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080


# Database
# DATABASE_URL=sqlite:///./ai_powered_image.db

# Docker Compose Postgres
POSTGRES_USER=iqd
POSTGRES_PASSWORD=iqd
POSTGRES_DB=image_quality
POSTGRES_PORT=5432
